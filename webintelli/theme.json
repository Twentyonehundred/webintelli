{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "40rem",
			"wideSize": "68rem"
		},
		"color": {
			"custom": true,
			"defaultPalette": false,
			"palette": [
				{ "slug": "espresso", "color": "#1C1310", "name": "Espresso" },
				{ "slug": "roast", "color": "#2E211B", "name": "Roast" },
				{ "slug": "amber", "color": "#C4622D", "name": "Amber" },
				{ "slug": "cream", "color": "#FAF6F0", "name": "Cream" },
				{ "slug": "paper", "color": "#FFFDFA", "name": "Paper" },
				{ "slug": "muted", "color": "#6B5D54", "name": "Muted" }
			]
		},
		"typography": {
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "sans",
					"name": "Sans",
					"fontFamily": "\"Helvetica Neue\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Arial, sans-serif"
				},
				{
					"slug": "serif",
					"name": "Serif",
					"fontFamily": "\"Iowan Old Style\", \"Palatino Linotype\", Palatino, Georgia, serif"
				}
			],
			"fontSizes": [
				{ "slug": "small", "size": "0.9rem", "name": "Small" },
				{ "slug": "medium", "size": "1.06rem", "name": "Medium" },
				{ "slug": "large", "size": "1.5rem", "name": "Large" },
				{ "slug": "x-large", "size": "2.1rem", "name": "Extra Large" }
			]
		},
		"spacing": {
			"units": ["px", "em", "rem", "%", "vw"]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--cream)",
			"text": "var(--wp--preset--color--espresso)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.65"
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--amber)" }
			},
			"h1": { "typography": { "fontWeight": "800", "lineHeight": "1.1" } },
			"h2": { "typography": { "fontWeight": "800", "lineHeight": "1.15" } },
			"h3": { "typography": { "fontWeight": "700", "lineHeight": "1.2" } }
		}
	}
}
