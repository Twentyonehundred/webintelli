{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "40rem",
			"wideSize": "68rem"
		},
		"color": {
			"custom": true,
			"defaultPalette": false,
			"palette": [
				{ "slug": "white", "color": "#FFFFFF", "name": "White" },
				{ "slug": "shell", "color": "#FDFBF8", "name": "Shell" },
				{ "slug": "tint", "color": "#FAF6F1", "name": "Tint" },
				{ "slug": "amber", "color": "#C4622D", "name": "Amber" },
				{ "slug": "amber-soft", "color": "#F6E7DC", "name": "Amber Soft" },
				{ "slug": "ink", "color": "#241A15", "name": "Ink" },
				{ "slug": "muted", "color": "#6F6158", "name": "Muted" },
				{ "slug": "espresso", "color": "#1C1310", "name": "Espresso" }
			]
		},
		"typography": {
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "sans",
					"name": "Sans",
					"fontFamily": "\"Helvetica Neue\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Arial, sans-serif"
				},
				{
					"slug": "serif",
					"name": "Serif",
					"fontFamily": "\"Iowan Old Style\", \"Palatino Linotype\", Palatino, Georgia, serif"
				}
			],
			"fontSizes": [
				{ "slug": "small", "size": "0.9rem", "name": "Small" },
				{ "slug": "medium", "size": "1.06rem", "name": "Medium" },
				{ "slug": "large", "size": "1.5rem", "name": "Large" },
				{ "slug": "x-large", "size": "2.1rem", "name": "Extra Large" }
			]
		},
		"spacing": {
			"units": ["px", "em", "rem", "%", "vw"]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--white)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.65"
		},
		"elements": {
			"link": {
				"color": { "text": "#9C4A1C" }
			},
			"h1": {
				"typography": { "fontWeight": "800", "lineHeight": "1.1", "letterSpacing": "-0.025em" },
				"color": { "text": "var(--wp--preset--color--espresso)" }
			},
			"h2": {
				"typography": { "fontWeight": "800", "lineHeight": "1.15", "letterSpacing": "-0.025em" },
				"color": { "text": "var(--wp--preset--color--espresso)" }
			},
			"h3": {
				"typography": { "fontWeight": "700", "lineHeight": "1.2" },
				"color": { "text": "var(--wp--preset--color--espresso)" }
			}
		}
	}
}
